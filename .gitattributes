# Normalise to LF in the repository so Windows checkouts stop producing whole-file diffs.
* text=auto eol=lf

# Windows-first scripts are checked out with CRLF.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

*.exe binary
*.7z binary
*.dll binary
*.wav binary
*.mp3 binary
*.mp4 binary
*.webm binary
*.jpg binary
*.png binary
